<div class="ll-intent-prompt">
   <p>{{{localize
         "LL.Intent.Warning"
         itemName=itemName
         categoryName=categoryName
      }}}</p>
   <p>{{localize "LL.Intent.Question"}}</p>
   <ul style="margin-top: 0.4em;">
      <li><strong>{{localize "LL.Intent.Resist"}}:</strong>
         {{localize "LL.Intent.ResistDesc"}}</li>
      <li><strong>{{localize "LL.Intent.Embrace"}}:</strong>
         {{localize "LL.Intent.EmbraceDesc"}}</li>
   </ul>
</div>